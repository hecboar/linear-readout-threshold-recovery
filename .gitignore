# Byte-compiled
__pycache__/
*.py[cod]

# Virtual environments
.venv/
venv/

# LaTeX build artefacts. paper/tmlr.pdf is committed deliberately: it is the artefact a
# reviewer opens, and regenerating it requires a full TeX installation. The retired
# elsarticle build is kept under paper/legacy/ for the same reason.
paper/*.aux
paper/*.log
paper/*.out
paper/*.bbl
paper/*.blg
paper/*.spl
paper/*.synctex.gz
paper/*.fdb_latexmk
paper/*.fls

# Smoke-test output; the committed results/ are the real campaigns
results/*_smoke/
results/logs/smoke/
