paper/*.log
paper/*.out
paper/*.bbl
paper/*.blg
paper/*.spl
paper/*.synctex.gz
paper/*.fdb_latexmk
paper/*.fls

# Generated by scripts/run_spark.sh for the pilot stage
configs/e7_pilot.json

# Smoke-test output; the committed results/ are the real campaigns
results/*_smoke/
